# GEMINI_API_KEY: Required for Gemini AI API calls (EchoBot AI).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE: Required for live Supabase Authentication, PostgreSQL, Storage, and Realtime.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# OPTIONAL EMAIL NOTIFICATION PROVIDER (Server-side only)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="CampusEcho MUST <notifications@campusecho.must.ac.ke>"

# OWNER ADMIN CONSOLE (Server-side only - never prefix with VITE_)
ADMIN_EMAIL="wjwaweru1@gmail.com"
ADMIN_ACCESS_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""


